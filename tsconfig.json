{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is here for the Next.js component, which is the one file in this build
    // that runs in a browser. tsc emits it, so it cannot live under the client's
    // own config, which is noEmit.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/cli/**/*.ts",
    "src/next/**/*.ts",
    "src/plugin/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/client"]
}
