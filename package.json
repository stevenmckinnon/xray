{
  "name": "@stevenmckinnon/xray",
  "version": "0.3.0",
  "description": "Hover any element in your running app and see which design tokens its computed styles map to — and which of them are locked to a single theme or density.",
  "type": "module",
  "license": "MIT",
  "author": "Steven McKinnon",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xray": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/client": {
      "types": "./dist/next/client.d.ts",
      "default": "./dist/next/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "prepublishOnly": "pnpm build",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "vite-plugin",
    "design-tokens",
    "design-system",
    "css-custom-properties",
    "devtools",
    "theming"
  ],
  "peerDependencies": {
    "next": ">=15.0.0",
    "playwright": "^1.40.0",
    "react": ">=18.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevenmckinnon/xray.git"
  },
  "bugs": {
    "url": "https://github.com/stevenmckinnon/xray/issues"
  },
  "homepage": "https://github.com/stevenmckinnon/xray#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.20.0"
}
