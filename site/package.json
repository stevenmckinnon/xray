{
  "name": "xray-site",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/changelog-page.mjs && fumadocs-mdx",
    "predev": "pnpm generate && node scripts/copy-client.mjs",
    "dev": "next dev --port 5300",
    "prebuild": "pnpm generate && node scripts/copy-client.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "pnpm generate && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "fumadocs-core": "^16.14.3",
    "fumadocs-mdx": "^15.2.3",
    "fumadocs-ui": "^16.14.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@stevenmckinnon/xray": "^0.4.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
