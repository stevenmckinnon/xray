{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Tests are included so the type checker sees them too. Vitest only transpiles,
  // so a test fixture that has drifted from the type it claims to build compiles
  // and passes while asserting against a shape that no longer exists.
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
